<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branch Tree View -->
    <record id="view_zkteco_branch_tree" model="ir.ui.view">
        <field name="name">zkteco.branch.tree</field>
        <field name="model">zkteco.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Branch Form View -->
    <record id="view_zkteco_branch_form" model="ir.ui.view">
        <field name="name">zkteco.branch.form</field>
        <field name="model">zkteco.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Branch Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Devices" name="devices">
                            <field name="device_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="serial_number"/>
                                    <field name="ip_address"/>
                                    <field name="online_status" widget="badge"
                                           decoration-success="online_status == 'online'"
                                           decoration-danger="online_status == 'offline'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employees" name="employees">
                            <field name="employee_ids" widget="many2many">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="job_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Branch Search View -->
    <record id="view_zkteco_branch_search" model="ir.ui.view">
        <field name="name">zkteco.branch.search</field>
        <field name="model">zkteco.branch</field>
        <field name="arch" type="xml">
            <search string="Search Branches">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Branch Action -->
    <record id="action_zkteco_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">zkteco.branch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first branch.
            </p>
            <p>
                Branches help group devices and employees, ensuring attendance configurations and users do not mix.
            </p>
        </field>
    </record>

    <!-- Branch Menu Item -->
    <menuitem id="menu_zkteco_branch"
              name="Branches"
              parent="menu_zkteco_configuration"
              action="action_zkteco_branch"
              sequence="20"
              groups="zkteco_attendance.group_zkteco_admin"/>
</odoo>
