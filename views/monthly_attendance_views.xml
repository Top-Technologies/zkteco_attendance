<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zkteco_monthly_attendance_form" model="ir.ui.view">
        <field name="name">zkteco.monthly.attendance.form</field>
        <field name="model">zkteco.monthly.attendance</field>
        <field name="arch" type="xml">
            <form string="Monthly Attendance Summary">
                <header>
                    <button name="action_compute" string="Compute Statistics" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_submit" string="Submit to Manager" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_manager_approve" string="Manager Approve" type="object" class="oe_highlight" invisible="state != 'manager_approve'"/>
                    <button name="action_hr_approve" string="HR Approve" type="object" class="oe_highlight" groups="hr.group_hr_manager" invisible="state != 'hr_approve'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state in ('draft', 'approved', 'rejected')"/>
                    <button name="action_set_to_draft" string="Set to Draft" type="object" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,manager_approve,hr_approve,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="month" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Statistics">
                        <group>
                            <field name="overtime_hours" readonly="state != 'draft'"/>
                            <field name="late_minutes" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="absent_days" readonly="state != 'draft'"/>
                            <field name="absent_hours" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zkteco_monthly_attendance_tree" model="ir.ui.view">
        <field name="name">zkteco.monthly.attendance.tree</field>
        <field name="model">zkteco.monthly.attendance</field>
        <field name="arch" type="xml">
            <list string="Monthly Attendance Summary" decoration-info="state == 'draft'" decoration-warning="state in ('manager_approve', 'hr_approve')" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="employee_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="overtime_hours" widget="float_time"/>
                <field name="late_minutes"/>
                <field name="absent_days"/>
                <field name="absent_hours" widget="float_time"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state in ('manager_approve', 'hr_approve')" 
                       decoration-success="state == 'approved'" 
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_zkteco_monthly_attendance_search" model="ir.ui.view">
        <field name="name">zkteco.monthly.attendance.search</field>
        <field name="model">zkteco.monthly.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Monthly Attendance">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <field name="year"/>
                <field name="month"/>
                <filter string="To Approve" name="to_approve" domain="[('state', 'in', ('manager_approve', 'hr_approve')), ('employee_id.user_id', '!=', uid)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="My Subordinates" name="my_subordinates" domain="['|', ('manager_id.user_id', '=', uid), ('employee_id.leave_manager_id', '=', uid)]"/>
                <filter string="My Records" name="my_records" domain="[('employee_id.user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zkteco_monthly_attendance" model="ir.actions.act_window">
        <field name="name">Monthly Attendance Approvals</field>
        <field name="res_model">zkteco.monthly.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zkteco_monthly_attendance_search"/>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_zkteco_monthly_attendance" 
              name="Monthly Summaries" 
              parent="zkteco_attendance.menu_zkteco_approvals_parent" 
              action="action_zkteco_monthly_attendance" 
              sequence="20"
              groups="zkteco_attendance.group_zkteco_manager"/>
</odoo>
